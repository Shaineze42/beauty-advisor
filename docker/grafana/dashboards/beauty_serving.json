{
  "uid": "beauty-advisor-serving",
  "title": "Beauty Advisor : API de serving et dérive",
  "tags": [
    "beauty-advisor",
    "serving",
    "mlops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
