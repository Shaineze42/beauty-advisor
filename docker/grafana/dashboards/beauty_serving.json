          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * increase(ba_request_duration_seconds_sum[1m]) / clamp_min(increase(ba_request_duration_seconds_count[1m]), 1)",
